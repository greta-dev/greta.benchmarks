diff --git a/tests/testthat/test-dag_class.R b/tests/testthat/test-dag_class.R
index a55610cb..54cb8322 100644
--- a/tests/testthat/test-dag_class.R
+++ b/tests/testthat/test-dag_class.R
@@ -13,3 +13,18 @@ test_that("the log-density and trace functions trace once per model", {
   expect_identical(traces(m$dag$tf_log_prob_function), 1L)
   expect_identical(traces(m$dag$tf_trace_values_batch), 1L)
 })
+
+test_that("opt() runs on a log-density function traced for one row", {
+  skip_if_not(check_tf_version())
+  y <- as_data(rnorm(10))
+  mu <- normal(0, 10)
+  distribution(y) <- normal(mu, 1)
+  m <- model(mu)
+
+  opt(m)
+
+  one_row <- m$dag$tf_log_prob_function_one_row
+  n_rows <- one_row$input_signature[[1]]$shape$as_list()[[1]]
+  expect_identical(as.integer(n_rows), 1L)
+  expect_identical(as.integer(one_row$experimental_get_tracing_count()), 1L)
+})
